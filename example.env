# Required. PostgreSQL connection for the account core.
ACCOUNT_DATABASE_URL=postgres://account:secret@localhost:5432/account

# Required, >=32 bytes. Pepper for token hashing and web sessions.
ACCOUNT_SESSION_SECRET=change-me-change-me-change-me-change-me

# Required, >=32 bytes. Shared credential for internal gRPC callers (adapters).
# Internal RPCs fail closed without it.
ACCOUNT_INTERNAL_KEY=change-me-internal-change-me-internal!

# Optional. Read-only key game servers at home use for the routing table
# (GET /internal/v1/routing*, header X-Routing-Key; docs/routing.md). Game
# servers set it as OPENPAK_ROUTING_KEY. Unset: the routing endpoints refuse.
ACCOUNT_ROUTING_KEY=

# Optional, >=32 bytes. Seals two-factor (TOTP) secrets at rest (AES-256-GCM).
# Unset derives the key from ACCOUNT_SESSION_SECRET. Changing it makes every
# enrolled authenticator unreadable (recovery codes still work).
ACCOUNT_TOTP_KEY=

# How long a closed (deleted) account stays restorable before the website's
# finaliser erases it everywhere (Go duration). Default 720h, 30 days.
ACCOUNT_DELETION_GRACE=720h

# Listen addresses.
ACCOUNT_GRPC_ADDR=:7000
ACCOUNT_HTTP_ADDR=:8000

# Web session lifetime (Go duration).
ACCOUNT_SESSION_TTL=720h

# development | production
ACCOUNT_ENVIRONMENT=production

# Optional comma-separated CORS origins.
ACCOUNT_ALLOWED_ORIGINS=

# Federation admission rules (internal/federation/requirements.go). Every
# figure the website shows comes from here via Federation.GetRequirements.
# Unset = the default shown. Node totals count all of a node's servers.
ACCOUNT_FEDERATION_NODE_CORES=8
ACCOUNT_FEDERATION_NODE_RAM_GB=16
ACCOUNT_FEDERATION_NODE_DISK_GB=160
ACCOUNT_FEDERATION_SERVER_CORES=2
ACCOUNT_FEDERATION_SERVER_RAM_GB=4
ACCOUNT_FEDERATION_SERVER_BANDWIDTH_MBPS=1000
# Floor for home's own timed transfer, each direction (sanity check, not a gigabit proof).
ACCOUNT_FEDERATION_MEASURED_MBPS=100
ACCOUNT_FEDERATION_AVAILABILITY_PCT=99.5
# Reported RAM/disk within this many percent of the figure still counts.
ACCOUNT_FEDERATION_SLACK_PCT=10
ACCOUNT_FEDERATION_REPORT_STALE=3m
ACCOUNT_FEDERATION_SELFTEST_INTERVAL=24h
ACCOUNT_FEDERATION_SELFTEST_MAX_AGE=72h
ACCOUNT_FEDERATION_SELFTEST_BYTES=100000000
