# Required. PostgreSQL connection for the account core.
ACCOUNT_DATABASE_URL=postgres://account:secret@localhost:5432/account

# Required, >=32 bytes. Pepper for token hashing and web sessions.
ACCOUNT_SESSION_SECRET=change-me-change-me-change-me-change-me

# Required, >=32 bytes. Shared credential for internal gRPC callers (adapters).
# Internal RPCs fail closed without it.
ACCOUNT_INTERNAL_KEY=change-me-internal-change-me-internal!

# Listen addresses.
ACCOUNT_GRPC_ADDR=:7000
ACCOUNT_HTTP_ADDR=:8000

# Web session lifetime (Go duration).
ACCOUNT_SESSION_TTL=720h

# development | production
ACCOUNT_ENVIRONMENT=production

# Optional comma-separated CORS origins.
ACCOUNT_ALLOWED_ORIGINS=
